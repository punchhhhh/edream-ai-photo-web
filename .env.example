# 复制为 .env 并按需修改
DATABASE_URL=postgresql+psycopg2://tailaogu@localhost:5432/edream_ai_photo
MEDIA_DIR=./media
ENTERPRISE_MEDIA_DIR=./enterprise_media
VIDEO_POLL_INTERVAL=5
VIDEO_TIMEOUT_SECONDS=900
MAX_UPLOAD_MB=20

# ---- 资产存储(腾讯云 COS) ----
# local = 本地磁盘(MEDIA_DIR,开发/测试零依赖);cos = 腾讯云 COS(需 pip install '.[cos]')
# 使用私有读写桶,访问时生成临时预签名链接;数据库只存对象 key,不依赖外部地址
STORAGE_BACKEND=local
COS_REGION=ap-guangzhou
# 存储桶完整名称(含 APPID,如 mybucket-1250000000)
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# 对象 key 统一前缀(多应用共用桶时区分用),留空表示不加
COS_PREFIX=edream
# 临时预签名链接有效期(秒)
COS_PRESIGN_EXPIRES_SECONDS=3600

# ---- 登录 ----
# jwt = Casdoor OAuth 授权码模式;dev = 本地开发免 OAuth(直接给 DEV_AUTH_SUB 发会话)
AUTH_MODE=jwt

# Casdoor 应用配置(jwt 模式必填,端点以 /.well-known/openid-configuration 为准)
OAUTH_AUTHORIZE_URL=https://casdoor.example.com/login/oauth/authorize
# 新版 Casdoor 用 /api/login/oauth/access_token,老版本是 /api/token
OAUTH_TOKEN_URL=https://casdoor.example.com/api/login/oauth/access_token
OAUTH_USERINFO_URL=https://casdoor.example.com/api/userinfo
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Casdoor 后台登记的回调地址,留空则按请求自动拼 /api/auth/callback
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# 会话
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# 跨域来源(逗号分隔);生产部署改为实际的前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# dev 模式使用的固定用户标识
DEV_AUTH_SUB=dev-user

# ---- 企业运营平台 ----
# 初始平台管理员 Casdoor sub，多个用逗号分隔
ENTERPRISE_ADMIN_SUBS=
ENTERPRISE_DEFAULT_QUOTA_MB=2048
ENTERPRISE_TEXT_MAX_CHARS=5000
ENTERPRISE_IMAGE_MAX_MB=20
ENTERPRISE_DOCUMENT_MAX_MB=50
ENTERPRISE_SOURCE_MAX_MB=200
ENTERPRISE_VIDEO_MAX_MB=500
ENTERPRISE_BATCH_MAX_FILES=20
ENTERPRISE_BATCH_MAX_MB=1024
# 独立 ops 域名部署时填写主业务地址；同域或本地开发可留空
ENTERPRISE_BUSINESS_BASE_URL=https://studio.example.com
# 主业务服务端调用 /api/internal/v1 时使用，生产务必设置高强度随机值
INTERNAL_SERVICE_TOKENS=

# ---- 企业共创视频 ----
# 共创视频统一走 new-api 网关:优先用企业主的默认模型配置(「一键 new-api 默认配置」
# 落库的地址与密钥);没有默认配置时,按企业 Owner 的 Casdoor 标识调 new-api 内部接口
# (GET /api/internal/user/api-keys,X-Key-Id/X-Key 鉴权)实时取其 system 密钥。
# 三项任一留空,主应用的"共创"tab 整体关闭。
NEW_API_BASE_URL=
NEW_API_INTERNAL_KEY_ID=
NEW_API_INTERNAL_KEY=
# "一键 new-api 默认配置"按钮的预填模型(只补空缺,不覆盖用户已选)
NEW_API_DEFAULT_CHAT_MODEL=deepseek-v4-flash
NEW_API_DEFAULT_IMAGE_MODEL=gpt-image-2
NEW_API_DEFAULT_VIDEO_MODEL=wan3_720p
# 每个成员可保留的共创视频上限(非失败状态的任务数)
COCREATION_MAX_VIDEOS_PER_USER=3
