# 复制为 .env 并按需修改
DATABASE_URL=postgresql+psycopg2://tailaogu@localhost:5432/edream_ai_photo
MEDIA_DIR=./media
VIDEO_POLL_INTERVAL=5
VIDEO_TIMEOUT_SECONDS=900
MAX_UPLOAD_MB=20

# ---- 资产存储(腾讯云 COS) ----
# local = 本地磁盘(MEDIA_DIR,开发/测试零依赖);cos = 腾讯云 COS(需 pip install '.[cos]')
# 使用私有读写桶,访问时生成临时预签名链接;数据库只存对象 key,不依赖外部地址
STORAGE_BACKEND=local
COS_REGION=ap-guangzhou
# 存储桶完整名称(含 APPID,如 mybucket-1250000000)
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# 对象 key 统一前缀(多应用共用桶时区分用),留空表示不加
COS_PREFIX=edream
# 临时预签名链接有效期(秒)
COS_PRESIGN_EXPIRES_SECONDS=3600

# ---- 登录 ----
# jwt = Casdoor OAuth 授权码模式;dev = 本地开发免 OAuth(直接给 DEV_AUTH_SUB 发会话)
AUTH_MODE=jwt

# Casdoor 应用配置(jwt 模式必填,端点以 /.well-known/openid-configuration 为准)
OAUTH_AUTHORIZE_URL=https://casdoor.example.com/login/oauth/authorize
# 新版 Casdoor 用 /api/login/oauth/access_token,老版本是 /api/token
OAUTH_TOKEN_URL=https://casdoor.example.com/api/login/oauth/access_token
OAUTH_USERINFO_URL=https://casdoor.example.com/api/userinfo
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Casdoor 后台登记的回调地址,留空则按请求自动拼 /api/auth/callback
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# 会话
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# 跨域来源(逗号分隔);生产部署改为实际的前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# dev 模式使用的固定用户标识
DEV_AUTH_SUB=dev-user
